{
  "name": "react-rspack-basepack",
  "version": "1.0.0",
  "description": "React basepack powered by Rspack (Rust-based bundler)",
  "private": true,
  "scripts": {
    "dev": "rspack serve",
    "build": "rspack build",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit --project jest/tsconfig.test.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest/jest.config.mjs --runInBand",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest/jest.config.mjs --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest/jest.config.mjs --coverage --runInBand"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@rspack/cli": "^2.3.1",
    "@rspack/core": "^2.3.1",
    "@rspack/dev-server": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "react-refresh": "^0.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
